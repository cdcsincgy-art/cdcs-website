# Copy this file to .env.local for local development. For deployments, set the
# same keys in Vercel: Project → Settings → Environment Variables.
#
# All keys are NEXT_PUBLIC_* — they are inlined into the client bundle at build
# time and are visible to anyone. Do not put real secrets here.

# --- Quote form backend (Formspree) -----------------------------------------
# The quote form POSTs here. Without it, the form falls back to opening a
# pre-filled email. Get the endpoint from your Formspree form's settings page.
NEXT_PUBLIC_QUOTE_FORM_ENDPOINT=https://formspree.io/f/xxxxxxxx

# --- Google Analytics 4 ----------------------------------------------------
# Measurement ID, format G-XXXXXXXXXX (Admin → Data streams → your web stream).
# Optional: src/lib/site-config.ts already carries the production ID as a
# fallback, and analytics only load on the live domain (never localhost or
# Vercel preview URLs), so you normally don't need to set this.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-HE4BG5Z5MD
