# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# raw project photo originals — kept OUTSIDE /public in source-photos/ so they
# are never deployed or copied into out/; the optimized versions in
# public/images/projects/ are committed. See scripts/process-project-images.mjs.
/source-photos/
/public/images/IMG_*

# project photos awaiting client publication approval — kept out of /public
# (and out of git) until approved; see scripts/pending-assets.json
/staging/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel
.env*
!.env.example
